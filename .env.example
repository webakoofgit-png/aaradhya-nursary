# MySQL connection created in your hosting provider. Never commit real credentials.
DATABASE_URL=mysql://aaradhya_app:replace-me@your-mysql-host:3306/aaradhya_nursery
DATABASE_SSL=true
# Optional: path to the provider's CA certificate when it is not in the system trust store.
# DATABASE_SSL_CA=C:/secure/path/provider-ca.pem

# Local one-time database creation only. Remove MYSQL_ADMIN_PASSWORD after creation.
MYSQL_ADMIN_HOST=127.0.0.1
MYSQL_ADMIN_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=replace-with-your-local-root-password
MYSQL_DATABASE=aaradhya_nursery
MYSQL_APP_USER=aaradhya_app
MYSQL_APP_PASSWORD=replace-with-a-separate-long-random-password
MYSQL_APP_HOST=localhost

# Used by the migration to create the first administrator securely.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

PUBLIC_APP_URL=http://localhost:8080
PASSWORD_RESET_WEBHOOK_URL=

# Merchant UPI address used to generate secure payment links after an order is created.
# Example only: replace with the nursery's real verified UPI ID.
UPI_ID=
